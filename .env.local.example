# Local PostgreSQL. Azure production resolves DATABASE_URL from Key Vault and
# uses TLS, so DATABASE_SSL_MODE=disable must remain local only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/laidbackhr
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10

# Auth.js and Google OAuth. Generate a local AUTH_SECRET with:
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local actor and seed behavior. Never enable LOCAL_UI_PREVIEW in production.
LOCAL_UI_PREVIEW=true
SEED_DEMO_DATA=false
BOOTSTRAP_ADMIN_EMAIL=local-admin@laidbackhr.ai
BOOTSTRAP_ADMIN_NAME=Local administrator
ANALYTICS_CACHE_TTL_MS=0
APP_VERSION=local

# Optional Azure Blob Storage for employee documents. Document operations are
# unavailable locally when these are empty; files are never written to disk.
EMPLOYEE_DOCUMENTS_ACCOUNT_URL=
EMPLOYEE_DOCUMENTS_CONTAINER=employee-documents

# Optional Azure AI configuration. Without it, the assistant uses the embedded
# knowledge retriever and deterministic evidence renderer.
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX=laidbackhr-knowledge-v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Azure administrator-monitor configuration.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=Laidback.ai
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
