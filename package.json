{
  "name": "laidbackhr-ai",
  "version": "1.0.0",
  "description": "Azure-native workforce operations, employee self-service, retention intelligence, and governed AI workflows.",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "LOCAL_UI_PREVIEW=true next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "dev:azure": "pnpm dev",
    "build:azure": "pnpm build",
    "start:azure": "pnpm start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:backend": "cd backend && PYTHONPATH=. .venv/bin/python -m pytest -q",
    "test:providers": "tsx --test tests/admin-provider-cache.test.ts",
    "test:priority": "tsx --test tests/work-priority.test.ts",
    "test:onboarding": "tsx --test tests/onboarding.test.ts",
    "test:pagination": "tsx --test tests/pagination.test.ts",
    "test:insights": "tsx --test tests/workforce-insights.test.ts",
    "test:knowledge": "node scripts/evaluate-knowledge.mjs",
    "test:operations": "tsx --import ./scripts/register-sql-loader.mjs scripts/test-operational-flows.ts",
    "test:interactions": "node scripts/audit-interactions.mjs",
    "model:export": "cd backend && PYTHONPATH=. .venv/bin/python scripts/export_web_runtime.py",
    "test:live": "node --test tests/api-live.test.mjs",
    "test:concurrency": "node --test tests/concurrency-live.test.mjs",
    "test:ai-redteam": "node --test tests/ai-redteam-live.test.mjs",
    "ai:sync": "node scripts/sync-ai-search.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.33.0",
    "@base-ui/react": "^1.5.0",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/mcp-adapters": "1.1.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.3.1",
    "write-excel-file": "4.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.11",
    "typescript": "5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
