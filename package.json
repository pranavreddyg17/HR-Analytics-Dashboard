    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.16.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "1.17.1",
